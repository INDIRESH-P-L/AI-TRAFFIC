# TRAFFICINTEL AI - Environment Configuration Example
PROJECT_NAME="TRAFFICINTEL AI"
TAGLINE="REAL-TIME INTELLIGENCE FOR SAFER, SMARTER TRAFFIC"
ENVIRONMENT="production"
DEBUG=false

# Database Configuration
# PostgreSQL (Production): postgresql://postgres:password@localhost:5432/trafficintel
# SQLite (Zero-friction local standalone): sqlite:///./trafficintel.db
DATABASE_URL="sqlite:///./trafficintel.db"

# Security & JWT
SECRET_KEY="replace-this-with-a-cryptographically-secure-random-64-byte-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Safety Engine Defaults (Seconds)
COMMAND_FRESHNESS_WINDOW_SEC=5.0

# Telemetry Quality Freshness Thresholds (Seconds)
DATA_FRESH_THRESHOLD_SEC=15
DATA_AGING_THRESHOLD_SEC=60
DATA_STALE_THRESHOLD_SEC=180

# External Providers
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
