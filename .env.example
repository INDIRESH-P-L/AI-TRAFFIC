# TRAFFICINTEL AI - Environment Configuration Example
PROJECT_NAME="TRAFFICINTEL AI"
TAGLINE="REAL-TIME INTELLIGENCE FOR SAFER, SMARTER TRAFFIC"
ENVIRONMENT="development"
DEBUG=false

# Database Configuration
# PostgreSQL (Production): postgresql+psycopg://user:password@host:5432/trafficintel
# SQLite (Zero-friction local standalone): sqlite:///./trafficintel.db
# Both dialects are exercised by the test suite; see README section 9.2.
DATABASE_URL="sqlite:///./trafficintel.db"

# Connection pooling. Ignored for SQLite. Sized for a control room - a handful
# of operators plus the polling thread - not for public web traffic. The
# ceiling matters more than the floor: an unbounded pool turns one slow query
# into exhausted connections for every other service on the same server.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SEC=30
DB_POOL_RECYCLE_SEC=1800
DB_CONNECT_TIMEOUT_SEC=10
DB_STATEMENT_TIMEOUT_SEC=30.0

# --- docker compose only (see README section 9) ---------------------------
# Compose refuses to start without a password rather than inventing a default.
POSTGRES_PASSWORD=""
POSTGRES_USER="trafficintel"
POSTGRES_DB="trafficintel"
CONSOLE_PORT=8080

# Initial operator account (python -m app.bootstrap_admin). Required in
# production: this account can command signal controllers, so the app refuses
# an absent password, the published development password, or anything under 12
# characters. Never committed - set it at provisioning time and remove it.
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_EMAIL="admin@trafficintel.gov"
INITIAL_ADMIN_PASSWORD=""

# Security & JWT
# REQUIRED in production: the application refuses to start with the placeholder
# key while ENVIRONMENT=production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-this-with-a-cryptographically-secure-random-64-byte-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS. Accepts a JSON array or a plain comma-separated string.
# LEAVE EMPTY when the console and API share one origin (the docker compose
# topology): requests are same-origin, CORS is never consulted, and an empty
# allow-list grants no cross-origin access to the traffic network at all.
# With ENVIRONMENT=production the app REFUSES TO START if this still contains
# localhost or is a wildcard.
BACKEND_CORS_ORIGINS=""

# Controller polling. Exactly ONE instance across the deployment may poll:
# two pollers write two rows per observation and double every measure derived
# from the signal state log. A lease enforces this (README section 9.3), so
# leaving it true on every replica is safe.
CONTROLLER_POLL_ENABLED=true
CONTROLLER_POLL_INTERVAL_SEC=2.0

# Safety Engine Defaults (Seconds)
COMMAND_FRESHNESS_WINDOW_SEC=5.0

# Telemetry Quality Freshness Thresholds (Seconds)
DATA_FRESH_THRESHOLD_SEC=15
DATA_AGING_THRESHOLD_SEC=60
DATA_STALE_THRESHOLD_SEC=180

# NTCIP 1202 Signal Controller Integration (SNMPv1 over UDP)
NTCIP_DEFAULT_PORT=161
NTCIP_TIMEOUT_SEC=2.0
NTCIP_RETRIES=1
NTCIP_READ_COMMUNITY="public"
NTCIP_WRITE_COMMUNITY="private"

# External Providers
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"

# GTFS-Realtime feeds for conditional transit signal priority (protobuf).
# Empty = TRANSIT_FEED_NOT_CONFIGURED. There is no demo feed: a simulated bus
# would put fabricated lateness into a decision that changes signal timing.
GTFS_RT_VEHICLE_POSITIONS_URL=""
GTFS_RT_TRIP_UPDATES_URL=""
# Some agencies require a key header, e.g. GTFS_RT_API_KEY_HEADER="x-api-key".
GTFS_RT_API_KEY_HEADER=""
GTFS_RT_API_KEY=""
GTFS_RT_TIMEOUT_SEC=5.0
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
